{
  "name": "service-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "node --check vite.config.js && npm run plan:check && npm run coupons:check && node --test scripts/*.test.mjs",
    "plan:new": "node scripts/plan.mjs new",
    "plan:list": "node scripts/plan.mjs list",
    "plan:check": "node scripts/plan.mjs check",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "coupons:check": "node scripts/coupons.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vite": "8.3.5"
  }
}
